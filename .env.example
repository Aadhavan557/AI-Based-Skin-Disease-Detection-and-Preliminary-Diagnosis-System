# ─────────────────────────────────────────────────────────
#  Skin Disease Detection API — Environment Configuration
#  Copy this file to ".env" and fill in your values.
# ─────────────────────────────────────────────────────────

# ── MongoDB ───────────────────────────────────────────────
# Option A: Local MongoDB (default)
MONGODB_URL=mongodb://localhost:27017

# Option B: MongoDB Atlas (cloud — recommended for quick setup)
# 1. Sign up free at https://www.mongodb.com/atlas
# 2. Create a FREE cluster, then click "Connect" → "Connect your application"
# 3. Paste your connection string below (replace <username> and <password>)
# MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

DATABASE_NAME=skindisease_db

# ── JWT Auth ──────────────────────────────────────────────
# IMPORTANT: Change this to a long, random string in production!
SECRET_KEY=super_secret_jwt_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days

# ── App ───────────────────────────────────────────────────
DEBUG_MODE=True
